{
  "name": "disclosure-delivery-service",
  "version": "0.1.0",
  "private": true,
  "description": "Disclosure Delivery Service",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "db:seed": "prisma db seed",
    "test": "prisma generate && node --test",
    "lint": "eslint . --max-warnings 0 && prettier . --check",
    "lint:fix": "eslint . --fix && prettier . --write"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tsx": "^4.23.15"
  }
}
